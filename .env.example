HTTP_HOST=0.0.0.0
JWT_KEY="your_jwt_key"
DATABASE_PATH=./database.sqlite
FIREBASE_APP_IDENTIFIER=your_firebase_app_identifier

# APNs authentication uses a .p8 key from the Apple Developer portal.
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_TOPIC=your.resigned.bundle.id
# Use sandbox for development builds. Use production for Ad Hoc and App Store builds.
APNS_ENVIRONMENT=sandbox
# Store the key on one line. Use \n for each line break. Do not add quotes.
APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
